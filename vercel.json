{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/resources/tools/ai-visibility-checker", "destination": "/services#local-seo", "permanent": true },
    { "source": "/resources/:path*", "destination": "/services", "permanent": true },
    { "source": "/resources", "destination": "/services", "permanent": true },
    { "source": "/blog", "destination": "/faq", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(video|img)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
