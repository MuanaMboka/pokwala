{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/work",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/demos",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/demos/:path*",
      "destination": "/portfolio/:path*",
      "permanent": true
    },
    {
      "source": "/resources/tools/ai-visibility-checker",
      "destination": "/services#local-seo",
      "permanent": true
    },
    {
      "source": "/resources/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/faq",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/portfolio/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(video|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portfolio/:slug/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
