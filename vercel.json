{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/resources", "destination": "/blog", "permanent": true },
    { "source": "/resources/tools/ai-visibility-checker", "destination": "/tools/ai-visibility-checker", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(video|img)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
